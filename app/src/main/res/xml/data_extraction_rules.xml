<?xml version="1.0" encoding="utf-8"?>
<!-- Данные остаются только на устройстве: исключаем всё из облачного бэкапа и переноса устройств.
     Свою резервную копию пользователь делает экспортом в JSON. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
