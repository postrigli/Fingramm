<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет 4×2 (≈250×110 dp): показатели месяца и кнопки. Растягивается; верхний предел 5×3 — для Android 12+ (xml-v31).
     Раз в час система просит обновить виджет: так месяц меняется на новый, даже если приложение не запускали. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_month"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="3600000"
    android:widgetCategory="home_screen" />
